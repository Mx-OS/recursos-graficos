title: |md
  # Diagrama General de MxOS
| {near: top-center}

# Establecemos la dirección general del diagrama de arriba hacia abajo.
direction: down

# --- Nodos ---
Comunidad: "Comunidad" { shape: rectangle }
Consejo: "Consejo Directivo" { shape: rectangle }
Vigilancia: "Órgano de Vigilancia" { shape: rectangle }
Equipo: "Equipo Ejecutivo" { shape: rectangle }
Comites: "Comités Técnicos y de Trabajo" { shape: cloud }

# --- Conexiones ---
Comunidad -> Consejo: "Elige, supervisa y tiene poder de revocatoria"
Consejo -> Equipo: "Nombra y remueve"
Equipo -> Consejo: "Reporta a"

# A esta conexión se le añade un estilo de línea punteada.
Comunidad -> Comites: "Puede crear" {
  style.stroke-dash: 4
}

Vigilancia -> Consejo: Vigila a {
	style.stroke-dash: 4
}

Vigilancia -> Equipo Ejecutivo: Vigila a {
	style.stroke-dash: 4
}

Vigilancia -> Comites: Vigila a {
	style.stroke-dash: 4
}

Consejo -> Comites: "Puede crear"
Consejo -> Comites: "Puede crear"
Comites -> Consejo: "Reportan a"
